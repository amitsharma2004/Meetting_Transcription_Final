# STT Provider Keys
SARVAM_API_KEY=sk_your_sarvam_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# LLM Cleanup Keys (Optional)
GROQ_API_KEY=gsk_your_groq_key_here
GOOGLE_API_KEY=AIzaSy_your_google_key_here

# STT & LLM Defaults
STT_PROVIDER=sarvam
SARVAM_MODEL=saarika:v2.5
OPENAI_STT_MODEL=whisper-1

# Speaker Recognition Biometrics
SPEAKER_SIMILARITY_THRESHOLD=0.40
SPEAKER_SIMILARITY_MARGIN=0.12
